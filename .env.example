# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Local PostgreSQL via Unix socket (native WSL install, peer auth)
DATABASE_URL=postgresql://YOUR_LINUX_USER@localhost:5432/instafeed_dev?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql://YOUR_LINUX_USER@localhost:5432/instafeed_test?host=/var/run/postgresql

REDIS_URL=redis://localhost:6379

# --- Video providers (all optional; empty = "not configured" in the UI) ---
YOUTUBE_API_KEY=
# Bunny Stream library: dashboard → Stream → your library → API
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
# Webhook URL to set in Bunny: <app url>/webhooks/bunny ; key used to verify X-BunnyStream-Signature
BUNNY_STREAM_WEBHOOK_KEY=
UPLOAD_MAX_MB=500
# TikTok Login Kit + Display API (also enable feature flag tiktok_display_api). Redirect URI: <app url>/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login (flag instagram_api). Redirect URI: <app url>/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v24.0
# Instagram Reel link embedding via Meta oEmbed: "<app-id>|<client-token>" (flag instagram_oembed, needs oEmbed Read approval)
META_OEMBED_TOKEN=

# Shopify (Dev Dashboard app) — secret goes only in .env
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_themes,write_pixels,read_customer_events
SHOPIFY_APP_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# AI widget assistant (also enable feature flag ai_assistant). Leave empty to disable.
ANTHROPIC_API_KEY=
