# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Local PostgreSQL via Unix socket (native WSL install, peer auth)
DATABASE_URL=postgresql://YOUR_LINUX_USER@localhost:5432/instafeed_dev?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql://YOUR_LINUX_USER@localhost:5432/instafeed_test?host=/var/run/postgresql

REDIS_URL=redis://localhost:6379
