generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlanId {
  FREE
  STARTER
  GROWTH
  PRO
}

/// Subscription plans and their entitlements. Seeded; billing wiring arrives in Phase 9.
model Plan {
  id               PlanId   @id
  name             String
  priceMonthlyUsd  Int      // whole cents
  limits           Json     // { videos, widgets, monthlyViews, storageGb }
  features         String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Global default (storeId null) with optional per-store override (added in Phase 2).
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  storeId   String?
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([key, storeId])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  ANALYST
}

model Store {
  id             String    @id @default(cuid())
  shopDomain     String    @unique
  name           String?
  currency       String?
  timezone       String?
  // Expiring offline tokens (required for new public apps). AES-256-GCM, never leave the API.
  accessTokenEnc        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  scopes         String?
  installedAt    DateTime?
  uninstalledAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  products         Product[]
  variants         Variant[]
  syncRuns         SyncRun[]
  videos           Video[]
  videoProducts    VideoProduct[]
  providerAccounts ProviderAccount[]
  oauthStates      OAuthState[]
  widgets          Widget[]
  widgetVideos     WidgetVideo[]
  events           AnalyticsEvent[]
  dailyStats       DailyStat[]
  orders           Order[]
  settings         StoreSettings?
  integrations     Integration[]
  integrationLogs  IntegrationLog[]
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  passwordHash  String?
  name          String?
  shopifyUserId String?   @unique // "<shopDomain>:<sub>" from the admin session token
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

/// Email-login dashboard sessions. Only a SHA-256 hash of the opaque token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  storeId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Shopify delivers webhooks at least once; the webhook id makes processing idempotent.
model WebhookReceipt {
  id         String   @id @default(cuid())
  webhookId  String   @unique
  topic      String
  shopDomain String
  receivedAt DateTime @default(now())
}

/// Append-only. storeId is SET NULL on store deletion so entries survive for compliance.
model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  actorType String   // USER | SHOPIFY | SYSTEM | SUPPORT
  actorId   String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
}

/// Mirror of Shopify products. shopifyId is the GraphQL gid; deletedAt marks products removed in Shopify.
model Product {
  id               String    @id @default(cuid())
  storeId          String
  shopifyId        String
  handle           String
  title            String
  status           String    // ACTIVE | DRAFT | ARCHIVED | UNLISTED (Shopify ProductStatus)
  imageUrl         String?
  priceMin         Decimal?  @db.Decimal(14, 2)
  priceMax         Decimal?  @db.Decimal(14, 2)
  totalVariants    Int       @default(0)
  shopifyUpdatedAt DateTime
  syncedAt         DateTime
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants      Variant[]
  videoProducts VideoProduct[]

  @@unique([storeId, shopifyId])
  @@index([storeId, deletedAt, title])
}

model Variant {
  id               String   @id @default(cuid())
  storeId          String
  productId        String
  shopifyId        String
  title            String
  sku              String?
  price            Decimal  @db.Decimal(14, 2)
  availableForSale Boolean
  options          Json     // [{ name, value }]
  imageUrl         String?
  position         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  videoProducts VideoProduct[]

  @@unique([storeId, shopifyId])
  @@index([storeId, productId])
  @@index([storeId, sku])
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncRun {
  id         String     @id @default(cuid())
  storeId    String
  kind       String     // PRODUCTS_FULL
  status     SyncStatus @default(QUEUED)
  trigger    String     // MANUAL | INSTALL | SCHEDULED
  upserted   Int        @default(0)
  deleted    Int        @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  TIKTOK_URL
  TIKTOK_ACCOUNT
  INSTAGRAM_ACCOUNT
  INSTAGRAM_URL
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  UNAVAILABLE
}

/// A video in the merchant library. externalId is the provider id (Bunny guid, YouTube id, TikTok id, Instagram media id)
/// and powers duplicate detection. Instagram account imports are copied into Bunny (bunnyVideoId) because media_url expires.
model Video {
  id            String      @id @default(cuid())
  storeId       String
  source        VideoSource
  externalId    String
  bunnyVideoId  String?
  status        VideoStatus @default(PENDING)
  statusMessage String?
  title         String
  durationSec   Float?
  width         Int?
  height        Int?
  thumbnailUrl  String?
  playbackUrl   String?     // HLS for Bunny-hosted media
  embedUrl      String?     // official player URL for YouTube/TikTok/Instagram embeds
  permalink     String?     // original post, for attribution
  authorName    String?
  tags          String[]
  bytes         BigInt?
  archivedAt    DateTime?
  checkedAt     DateTime?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products     VideoProduct[]
  widgetVideos WidgetVideo[]

  @@unique([storeId, source, externalId])
  @@index([storeId, archivedAt, createdAt])
  @@index([storeId, bunnyVideoId])
}

/// Products (optionally a specific variant) tagged on a video, in display order.
model VideoProduct {
  id        String  @id @default(cuid())
  storeId   String
  videoId   String
  productId String
  variantId String?
  position  Int

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([storeId, videoId, productId])
  @@index([storeId, productId])
}

enum Provider {
  TIKTOK
  INSTAGRAM
}

/// A merchant-authorized creator account (TikTok Login Kit / Instagram Login). Tokens are AES-256-GCM encrypted.
model ProviderAccount {
  id                    String    @id @default(cuid())
  storeId               String
  provider              Provider
  externalUserId        String
  username              String?
  accessTokenEnc        String
  accessTokenExpiresAt  DateTime
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  scopes                String
  status                String    @default("ACTIVE") // ACTIVE | REAUTH_REQUIRED
  lastError             String?
  connectedById         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
}

/// Single-use OAuth state for provider connections; only the SHA-256 of the state value is stored.
model OAuthState {
  id        String   @id @default(cuid())
  stateHash String   @unique
  storeId   String
  userId    String
  provider  Provider
  expiresAt DateTime
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum WidgetType {
  STORIES
  CAROUSEL
  FLOATING
  BANNER
  GRID
  PRODUCT_GALLERY
}

enum WidgetStatus {
  DRAFT
  PUBLISHED
}

/// Draft config/targeting/videos are edited freely; publishing snapshots them into published* fields,
/// which are the only values the storefront ever reads. version supports optimistic concurrency.
model Widget {
  id                 String       @id @default(cuid())
  storeId            String
  name               String
  type               WidgetType
  status             WidgetStatus @default(DRAFT)
  config             Json
  targeting          Json
  version            Int          @default(1)
  publishedVersion   Int?
  publishedConfig    Json?
  publishedTargeting Json?
  publishedVideoIds  String[]
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  store  Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  videos WidgetVideo[]

  @@index([storeId, status])
}

/// Draft video list for a widget, in display order.
model WidgetVideo {
  id       String @id @default(cuid())
  storeId  String
  widgetId String
  videoId  String
  position Int

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([storeId, widgetId, videoId])
  @@index([storeId, videoId])
}

/// Raw storefront events (append-only), deduplicated on (storeId, eventId).
model AnalyticsEvent {
  id          String   @id @default(cuid())
  storeId     String
  eventId     String
  v           Int
  type        String
  visitorId   String
  widgetId    String?
  videoId     String?
  productId   String?
  variantId   String?
  quantity    Int?
  value       BigInt?
  currency    String?
  progress    Int?
  occurredAt  DateTime
  receivedAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, eventId])
  @@index([storeId, visitorId, occurredAt])
  @@index([storeId, occurredAt])
}

/// Daily counters at the finest grain (widget × video × product; "" = not applicable), bucketed in the store timezone.
/// Updated atomically with INSERT … ON CONFLICT DO UPDATE only for newly inserted (non-duplicate) events.
model DailyStat {
  storeId           String
  date              DateTime @db.Date
  widgetId          String   @default("")
  videoId           String   @default("")
  productId         String   @default("")
  widgetImpressions Int      @default(0)
  videoImpressions  Int      @default(0)
  videoOpens        Int      @default(0)
  videoStarts       Int      @default(0)
  videoPauses       Int      @default(0)
  videoProgress     Int      @default(0)
  videoCompletes    Int      @default(0)
  productClicks     Int      @default(0)
  popupOpens        Int      @default(0)
  variantSelects    Int      @default(0)
  addToCarts        Int      @default(0)
  addToCartValue    BigInt   @default(0)
  checkoutStarts    Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, date, widgetId, videoId, productId])
}

enum Attribution {
  PENDING
  DIRECT
  ASSISTED
  NONE
}

/// Orders from the orders/create webhook (shop currency, minor units). One row per Shopify order.
model Order {
  id                 String      @id @default(cuid())
  storeId            String
  shopifyOrderId     String
  name               String?
  createdAtShopify   DateTime
  currency           String
  totalMinor         BigInt
  lineItems          Json        // [{ productGid, variantGid, quantity, amountMinor }]
  visitorId          String?
  test               Boolean     @default(false)
  cancelledAt        DateTime?
  attribution        Attribution @default(PENDING)
  attributedMinor    BigInt      @default(0)
  attributedWidgetId String?
  attributedVideoId  String?
  /// Direct revenue split per product: [{ productId, amountMinor }]
  attributedLines    Json        @default("[]")
  attributedAt       DateTime?
  createdAt          DateTime    @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, createdAtShopify])
}

/// Per-store settings (more fields arrive in Phase 9).
model StoreSettings {
  storeId               String   @id
  attributionWindowDays Int      @default(7)
  /// Validated CSS applied inside widget shadow roots only.
  customCss             String   @default("")
  updatedAt             DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum IntegrationKind {
  GA4
  GTM
  META
  MIXPANEL
  CLEVERTAP
}

/// Analytics/marketing destination. publicConfig is safe for the storefront (ids only);
/// secretsEnc (AES-256-GCM JSON) holds server-only credentials used for test events.
model Integration {
  id            String          @id @default(cuid())
  storeId       String
  kind          IntegrationKind
  enabled       Boolean         @default(true)
  publicConfig  Json
  secretsEnc    String?
  events        String[]
  status        String          @default("NOT_TESTED") // NOT_TESTED | OK | ERROR
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind])
}

model IntegrationLog {
  id        String          @id @default(cuid())
  storeId   String
  kind      IntegrationKind
  level     String          // info | error
  message   String
  createdAt DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind, createdAt])
}
